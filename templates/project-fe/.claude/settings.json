{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "mvp": {
      "source": {
        "source": "github",
        "repo": "OlegShevtsov1/1_mvp_sdlc"
      }
    }
  },
  "enabledPlugins": {
    "sdlc@mvp": true,
    "mvp-sdlc@mvp": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Edit(docs/features/*/state.json)",
      "Write(docs/features/*/state.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git tag -d*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git tag -f*)",
      "Bash(git tag --force*)",
      "Bash(git tag --delete*)"
    ]
  }
}
