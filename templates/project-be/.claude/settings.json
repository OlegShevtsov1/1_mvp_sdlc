{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "mvp": {
      "source": {
        "source": "github",
        "repo": "OlegShevtsov1/1_mvp_sdlc"
      }
    }
  },
  "enabledPlugins": {
    "sdlc@mvp": true,
    "mvp-sdlc@mvp": true
  },
  "permissions": {
    "allow": [
      "mcp__plugin_mvp-sdlc_mvp-rag__search",
      "mcp__plugin_mvp-sdlc_mvp-rag__get"
    ],
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(config/master.key)",
      "Edit(config/master.key)",
      "Read(config/credentials*)",
      "Read(config/credentials/**)",
      "Edit(config/credentials*)",
      "Edit(config/credentials/**)",
      "Edit(docs/features/*/state.json)",
      "Write(docs/features/*/state.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git tag -d*)",
      "Bash(git push --delete*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * :refs/tags/*)",
      "Bash(git push * :v*)",
      "Bash(git push * +refs/tags/*)",
      "Bash(git push * +v*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git tag --delete*)",
      "Bash(git -c core.hooksPath*)"
    ]
  }
}
