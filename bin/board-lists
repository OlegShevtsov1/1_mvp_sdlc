#!/usr/bin/env python3
"""Print the lists of a project's Trello board, one per line, in board order (decision 53).

Usage: bin/board-lists
bin/project-add creates a new project's board with exactly these lists in this order. The names are
BOARD_LISTS in plugins/mvp-sdlc/lib/sdlc_common.py, the constant feature-start and task-brief use; a new project
has no factory profile yet, so these are the defaults, never renames.
Exit 0, 2 on usage.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "plugins" / "mvp-sdlc" / "lib"))
import sdlc_common  # noqa: E402


def main(argv):
    if argv:
        print("usage: bin/board-lists", file=sys.stderr)
        return 2
    for _, name in sdlc_common.BOARD_LISTS:
        print(name)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
