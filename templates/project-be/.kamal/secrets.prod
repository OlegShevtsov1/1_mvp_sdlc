# Kamal 2 secrets for the prod deployment (config/deploy.yml -> secrets_path).
#
# Never put a literal secret here: every value is an indirection into the environment of
# whoever runs deploy/deploy.sh prod (the Kamal Deploy workflow, or an operator's shell).
# deploy/_common.sh refuses to deploy while any variable referenced below is empty, and the Kamal
# Deploy preflight checks the same names before anything touches prod.
#
# POSTGRES_PASSWORD is interpolated into a URL, so keep it URL-safe (letters and digits).
# It initialises the database volume on the first deploy and must not change afterwards.

SECRET_KEY_BASE=${SECRET_KEY_BASE}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@${PROJECT_NAME}-db:5432/${PROJECT_NAME}_prod
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ALLOWED_FE_DSN=${SENTRY_ALLOWED_FE_DSN}
SMOKE_TOKEN=${SMOKE_TOKEN}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
