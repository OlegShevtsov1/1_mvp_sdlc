# Public-safe project identity read by config/deploy.yml, config/deploy.dev.yml, deploy/*.sh and
# .github/workflows/dev-deploy.yml. Plain NAME=value lines only, no quotes or trailing comments:
# all but deploy/*.sh take everything after the first '=' (spec/deploy/project_env_spec.rb).
# Never add IPs, machine hostnames, account ids or secrets here: this repository is going public.
PROJECT_NAME={{PROJECT_NAME}}
PROJECT_ZONE={{PROJECT_ZONE}}
