#!/usr/bin/env bash
# Published release tags are never moved or deleted (R-C9): a release must stay reproducible from
# exactly the commit that was tested. Refuses, for any remote ref refs/tags/v*:
#   - a deletion (git push --delete origin vX.Y.Z, or pushing :refs/tags/vX.Y.Z after git tag -d);
#   - an update of a tag the remote already has (git push --force of a moved or recreated tag).
# A new tag passes. Installed per clone with `git config core.hooksPath .githooks` (bin/setup).
# git feeds one line per ref: <local ref> <local oid> <remote ref> <remote oid>.
set -euo pipefail

zero='^0+$'
refused=0
while read -r _local_ref local_oid remote_ref remote_oid; do
  [[ "$remote_ref" == refs/tags/v* ]] || continue
  if [[ "$local_oid" =~ $zero ]]; then
    echo "pre-push: refusing to delete the published release tag ${remote_ref#refs/tags/}" >&2
    refused=1
  elif [[ ! "$remote_oid" =~ $zero && "$remote_oid" != "$local_oid" ]]; then
    echo "pre-push: refusing to move the published release tag ${remote_ref#refs/tags/}" >&2
    refused=1
  fi
done
exit "$refused"
